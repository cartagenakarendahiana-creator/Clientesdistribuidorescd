{
  "rules": {
    "casaDoradaDatos": {
      ".read": "auth != null && root.child('accesos/uids/' + auth.uid + '/rol').exists()",
      ".write": "auth != null && (root.child('accesos/uids/' + auth.uid + '/rol').val() === 'admin' || root.child('accesos/uids/' + auth.uid + '/rol').val() === 'trabajador')",
      "auth": {
        ".validate": false
      },
      "usuarios": {
        ".validate": false
      }
    },
    "siigo": {
      ".read": "auth != null && (root.child('accesos/uids/' + auth.uid + '/rol').val() === 'admin' || root.child('accesos/uids/' + auth.uid + '/rol').val() === 'lector')",
      ".write": false
    },
    "accesos": {
      "uids": {
        "$uid": {
          ".read": "auth != null && auth.uid === $uid"
        }
      }
    },
    "fotosGuias": {
      ".read": "auth != null && root.child('accesos/uids/' + auth.uid + '/rol').exists()",
      ".write": "auth != null && (root.child('accesos/uids/' + auth.uid + '/rol').val() === 'admin' || root.child('accesos/uids/' + auth.uid + '/rol').val() === 'trabajador')"
    }
  }
}
